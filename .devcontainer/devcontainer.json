{
    "name": "ACADEMIC PAGES",
    "dockerComposeFile": "../docker-compose.yaml",
    "service": "jekyll-site",
    "remoteEnv": {
        "VSCODE_SERVER_DIR": "/home/vscode/.vscode-server"
    },
    "workspaceFolder": "/usr/src/app",
    "remoteUser": "vscode",
    "forwardPorts": [4000],
    "portsAttributes": {
        "4000": { "label": "Website preview", "onAutoForward": "openBrowser" }
    },
    "postAttachCommand": "jekyll serve -H 0.0.0.0 -w --config _config.yml,_config_docker.yml -d /tmp/website-preview"
}
